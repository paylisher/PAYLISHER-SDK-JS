# ============================================
# Paylisher Web SDK - Docker Environment Variables
# ============================================
# Copy this file to .env.docker and fill in your values

# ==========================================
# Build Metadata
# ==========================================
BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
VERSION=1.1.0
VCS_REF=$(git rev-parse --short HEAD)

# ==========================================
# Development Environment
# ==========================================
DEV_DATA_STUDIO_HOST=http://localhost:8000
DEV_CAMPAIGN_HOST=http://localhost:4040

# ==========================================
# Test Environment (Dünya Katılım Test)
# ==========================================
# TEST_DATA_STUDIO_HOST=https://analytics-test.dunyadkatilim.com.tr
# TEST_CAMPAIGN_HOST=https://links-test.dunyadkatilim.com.tr

# ==========================================
# Production SaaS Environment
# ==========================================
# PROD_DATA_STUDIO_HOST=https://analytics.paylisher.com
# PROD_CAMPAIGN_HOST=https://links.paylisher.com

# ==========================================
# On-Premise Customer (Dünya Katılım Prod)
# ==========================================
# ONPREM_DATA_STUDIO_HOST=https://analytics.dunyadkatilim.com.tr
# ONPREM_CAMPAIGN_HOST=https://links.dunyadkatilim.com.tr

# ==========================================
# Generic On-Premise Template
# ==========================================
# For other on-premise customers, use these variables:
# ONPREM_DATA_STUDIO_HOST=https://analytics.CUSTOMER_DOMAIN
# ONPREM_CAMPAIGN_HOST=https://links.CUSTOMER_DOMAIN

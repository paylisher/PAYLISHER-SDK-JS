# Paylisher Web SDK Build Configuration

# Data Studio Host (Analytics)
# Default: https://ds.i.paylisher.com
DATA_STUDIO_HOST=https://your-datastudio-instance.com

# Campaign Host (Attribution & Linking)
# Default: https://link.usepublisher.com
# For on-premise or custom domain deployments:
CAMPAIGN_HOST=https://link.your-custom-domain.com
